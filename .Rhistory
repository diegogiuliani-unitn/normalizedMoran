}
res <- numeric(length = nsim + 1)
for (i in 1:nsim) res[i] <- normalized.moran(sample(x), listw,
zero.policy)
res[nsim + 1] <- normalized.moran(x, listw, zero.policy)
rankres <- rank(res)
xrank <- rankres[length(res)]
diff <- nsim - xrank
diff <- ifelse(diff > 0, diff, 0)
